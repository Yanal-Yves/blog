# Dossier de génération du site (le résultat final)
/public

# Dossier de cache des ressources (images redimensionnées, css minifié...)
/resources/_gen

# Fichier de verrouillage temporaire pendant que "hugo serve" tourne
.hugo_build.lock

# Fichiers système (Mac/Windows) inutiles
.DS_Store
Thumbs.db

# Réglages Claude Code locaux (autorisations d'outils propres à la machine).
# On n'ignore que le fichier .local ; une éventuelle config partagée
# (.claude/settings.json, agents, hooks) reste, elle, versionnable.
.claude/settings.local.json

# Brouillons d'articles : notes de travail hors de content/, non publiées par
# Hugo et gardées hors du dépôt.
/drafts/

# Token GitHub local du conteneur (ne JAMAIS committer)
.env

# Clés SSH (deploy key) — ne JAMAIS committer une clé privée. Filet de sécurité
# au cas où une clé serait générée dans le dépôt ; le défaut reste de la stocker
# hors du repo (p. ex. ~/.ssh). Voir CONTAINER.md / .env.example.
id_ed25519*
id_rsa*
*_ed25519
*.pem